      "legacy_name": "canvas_remove_widget",
      "timeout_ms": 10000,
      "audit_level": "standard",
      "description": "Remove a widget from the canvas by exact #id selector.",
      "parameters": {
        "type": "object",
        "properties": {
          "widget_id": { "type": "string", "description": "Target widget ID" },
          "selector": { "type": "string", "description": "Exact #id selector" }
